{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortView",
  "version": "0.5.0",
  "identifier": "com.shixiongzhidao.port-view",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortView",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "师兄知道",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ShiXiongZhiDao",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/ShiXiongZhiDao/PortView/raw/release/latest.json",
        "https://github.com/ShiXiongZhiDao/PortView/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5OTA5QUIzNjkwNUVCOQpSV1M1WHBBMnF3bVpEWGdtZ213UnJYQ3FtR0ZZWUFpeVlIc3U0NldlRXd1Z3hBWTZ0K1NCRHpsago="
    }
  }
}
